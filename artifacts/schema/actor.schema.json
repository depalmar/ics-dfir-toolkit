{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/ics-dfir-toolkit/artifacts/schema/actor.schema.json",
  "title": "Threat actor profile",
  "description": "One reporter's cluster, as that reporter describes it. Attribution is reported, never computed: two clusters are merged only when a reporter equates them, and 'overlaps with' stays an alias with equated: false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "aliases", "reported_by", "link_confidence", "stated_confidence",
    "motivation", "summary", "platforms", "malware", "references"
  ],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/actor_id"},
    "name": {"type": "string"},
    "aliases": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/alias"}},
    "reported_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "link_confidence": {
      "$ref": "common.schema.json#/$defs/confidence",
      "description": "ours: provenance of the link between this cluster and the activity; one reporting party is medium however authoritative"
    },
    "stated_confidence": {"type": "string", "description": "the attributing party's own words, verbatim, with who said them"},
    "unverified": {"type": "boolean", "description": "required when link_confidence is low"},
    "state_nexus": {"type": "string", "description": "as the reporter assesses it, with the reporter named"},
    "motivation": {"enum": ["espionage", "disruption", "prepositioning", "hacktivism", "financial", "mixed", "unknown"]},
    "summary": {"type": "string"},
    "ics_kill_chain_stage": {
      "enum": ["stage-1", "stage-2", "unknown"],
      "description": "SANS/Dragos ICS Cyber Kill Chain: stage-1 is IT-side intrusion and OT reconnaissance; stage-2 is developing or delivering an ICS attack. Only as the reporter states it."
    },
    "stage_basis": {"type": "string", "description": "who places the actor at that stage, in their words"},
    "platforms": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/platform_id"}},
    "protocols": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/protocol_id"}},
    "malware": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/malware_id"}},
    "incidents": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/incident_id"}},
    "packs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/pack_id"}},
    "iocs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ioc_id"}},
    "cves": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/cve"}},
    "tradecraft": {
      "type": "array",
      "items": {"type": "string"},
      "description": "say whose behaviour each item is: malware, exploit script, or hands-on operator"
    },
    "attack": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/attack_id"}},
    "sectors": {"type": "array", "items": {"type": "string"}},
    "regions": {"type": "array", "items": {"type": "string"}},
    "victimology": {"type": "array", "items": {"type": "string"}},
    "first_seen": {"type": "string", "description": "as the reporter dates the actor; it dates the actor, not any CVE"},
    "last_seen": {"type": "string"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessed"],
        "properties": {
          "title": {"type": "string"},
          "url": {"$ref": "common.schema.json#/$defs/https"},
          "accessed": {"$ref": "common.schema.json#/$defs/date"},
          "kind": {"enum": ["vendor", "government", "researcher", "standard", "press"]},
          "quote": {"type": "string"},
          "read": {"enum": ["direct", "summariser"]}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
