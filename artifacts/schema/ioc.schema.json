{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/ics-dfir-toolkit/artifacts/schema/ioc.schema.json",
  "title": "Indicator set from one publication",
  "description": "Indicators parsed in code from one publisher's own file or table, with the publisher's role and context for each value. Never retyped, never enriched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "published", "page_url", "file_format", "license", "accessed", "staleness", "indicators"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/ioc_id"},
    "title": {"type": "string"},
    "publisher": {"type": "string"},
    "published": {"$ref": "common.schema.json#/$defs/date"},
    "page_url": {"$ref": "common.schema.json#/$defs/https"},
    "file_url": {"$ref": "common.schema.json#/$defs/https"},
    "file_format": {"enum": ["csv", "stix-2.0", "stix-2.1", "text", "json", "html-table", "html-list", "html-text", "pdf-table"]},
    "license": {"type": "string"},
    "accessed": {"$ref": "common.schema.json#/$defs/date"},
    "actors": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/actor_id"}},
    "malware": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/malware_id"}},
    "incidents": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/incident_id"}},
    "cves": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/cve"}},
    "platforms": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/platform_id"}},
    "staleness": {"type": "string", "description": "when the indicators were valid and why they may no longer be"},
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "role", "context"],
        "properties": {
          "type": {"enum": ["ipv4", "ipv6", "cidr", "domain", "url", "sha256", "sha1", "md5", "ja3", "path", "filename", "account", "user-agent", "asn"]},
          "value": {"type": "string", "minLength": 1, "description": "refanged; the site defangs"},
          "role": {
            "enum": ["actor-controlled", "compromised-infrastructure", "anonymiser", "multi-tenant", "suspected", "unknown"],
            "description": "the publisher's own characterisation; unknown when it gives none"
          },
          "first_seen": {"$ref": "common.schema.json#/$defs/fuzzy_date"},
          "last_seen": {"$ref": "common.schema.json#/$defs/fuzzy_date"},
          "context": {"type": "string"}
        }
      }
    }
  }
}
