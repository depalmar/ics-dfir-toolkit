{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/ics-dfir-toolkit/artifacts/schema/response.schema.json",
  "title": "OT containment and recovery playbook",
  "description": "Guidance, not automation. The order is fixed: safety first, then preserve, contain, rotate, eradicate, recover, verify. Every playbook has a do_not list - in OT a well-meant action can destroy evidence and move the process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform_id", "name", "safety_first", "preserve_first", "contain",
    "credential_exposure", "eradicate", "recover", "verify", "do_not", "sources"
  ],
  "properties": {
    "platform_id": {"$ref": "common.schema.json#/$defs/platform_or_all"},
    "name": {"type": "string"},
    "safety_first": {"$ref": "#/$defs/steps", "description": "agree the safe state, who may operate, and manual fallback with operations before anything else"},
    "preserve_first": {"$ref": "#/$defs/steps"},
    "contain": {"$ref": "#/$defs/steps"},
    "credential_exposure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "why", "action"],
        "properties": {
          "what": {"type": "string"},
          "why": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "eradicate": {"$ref": "#/$defs/steps"},
    "recover": {"$ref": "#/$defs/steps"},
    "verify": {"$ref": "#/$defs/steps"},
    "do_not": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "because"],
        "properties": {
          "action": {"type": "string"},
          "because": {"type": "string"},
          "basis": {"$ref": "common.schema.json#/$defs/basis"}
        }
      }
    },
    "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "basis"],
        "properties": {
          "step": {"type": "string"},
          "detail": {"type": "string"},
          "when": {"type": "string", "description": "verdict levels or conditions this applies to"},
          "owner": {"enum": ["operations", "engineering", "security", "vendor", "safety", "management"], "description": "who performs or must approve it"},
          "basis": {"$ref": "common.schema.json#/$defs/basis"}
        }
      }
    }
  }
}
