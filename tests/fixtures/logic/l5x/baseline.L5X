<Routines>
<Routine Name="MainRoutine" Type="RLL">
<Description>
<![CDATA[Example pump start sequence]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start delay before the pump runs]]>
</Comment>
<Text>
<![CDATA[XIC(Example_Run)TON(Example_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Run only below the high limit]]>
</Comment>
<Text>
<![CDATA[XIC(Example_Timer.DN)LES(Example_Pump1.SpeedSP,Example_HighLimit)OTE(StartDelayDone);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[AOI_ExampleValve(Example_Valve1,Example_Run,StartDelayDone,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(CalcRoutine,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CalcRoutine" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Example speed clamp]]>
</Line>
<Line Number="1">
<![CDATA[IF Example_Pump1.SpeedSP > Example_HighLimit THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Example_Pump1.SpeedSP := Example_HighLimit; (* clamp *)]]>
</Line>
<Line Number="3">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
