<FBDContent SheetSize="Letter (8.5x11in)" SheetOrientation="Landscape">
<Sheet Number="1">
<IRef ID="0" X="100" Y="100" Operand="Example_Run" HideDesc="false"/>
<ORef ID="1" X="300" Y="100" Operand="StartDelayDone" HideDesc="false"/>
<Wire FromID="0" ToID="1"/>
<TextBox ID="2" X="100" Y="40" Width="0">
<![CDATA[Example text box]]>
</TextBox>
</Sheet>
</FBDContent>
</Routine>
