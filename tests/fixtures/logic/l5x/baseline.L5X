<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Open only while the permissive is true]]>
</Comment>
<Text>
<![CDATA[XIC(OpenCmd)XIC(Permissive)OTE(OpenLatched);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(OpenLatched)OTE(OpenOut);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
