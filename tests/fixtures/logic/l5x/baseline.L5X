<AddOnInstructionDefinition Name="AOI_ExampleValve" Revision="1.0" Vendor="Example Vendor" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-01-05T08:00:00.000Z" CreatedBy="EXAMPLE\engineer1" EditedDate="2026-01-05T08:00:00.000Z" EditedBy="EXAMPLE\engineer1" SoftwareRevision="v36.00">
<Description>
<![CDATA[Example valve open command with permissive]]>
</Description>
<RevisionNote>
<![CDATA[Initial release]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
